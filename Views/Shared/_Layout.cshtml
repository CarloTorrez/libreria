<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Librería Páginas del Sur</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui-libreria.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <!-- Menú fijo: ~20% de la pantalla, siempre en el mismo lugar -->
        <nav class="app-menu">
            <div class="marca">Páginas del Sur<small>Librería</small></div>
            <a asp-controller="Libro" asp-action="Index"
               class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Libro" ? "activo" : "")">Libros</a>
            <a asp-controller="Proveedor" asp-action="Index"
               class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Proveedor" ? "activo" : "")">Proveedores</a>
        </nav>

        <!-- Área de trabajo: ~80% con espacio en blanco -->
        <main role="main" class="app-main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

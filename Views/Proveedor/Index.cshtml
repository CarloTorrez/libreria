@model List<PrototipoCRUD.Models.Proveedor>
@{
    ViewData["Title"] = "Proveedores";
}

<h2>Proveedores</h2>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">@TempData["Ok"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<p><a asp-action="Create" class="btn btn-primary">Nuevo proveedor</a></p>

<table class="table table-striped">
    <thead>
        <tr><th>Id</th><th>Nombre</th><th>Teléfono</th><th>Correo</th><th>Acciones</th></tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Id</td>
            <td>@p.Nombre</td>
            <td>@p.Telefono</td>
            <td>@p.Correo</td>
            <td>
                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
